# ─── Modo de operación ────────────────────────────────────────────────────────
BOT_MODE=PAPER
USE_TESTNET=false

# ─── Credenciales Kraken (rellenar con las tuyas) ────────────────────────────
# Crea las API keys en: Kraken > Settings > API
# Permisos requeridos: "Query Funds", "Create & Modify Orders".
# NUNCA habilites el permiso de retiros (Withdraw Funds).
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# ─── Activo base y pares de conversión ───────────────────────────────────────
# convert_base_asset: activo cripto "en reposo" desde/hacia el cual se convierte.
# Con DOGE como base, el bot parte de tu saldo en DOGE y convierte hacia/desde
# el resto de criptos disponibles en Kraken, y siempre vuelve a DOGE al cerrar.
CONVERT_BASE_ASSET=BTC
BRIDGE_ASSET=BTC
# TRADING_SYMBOLS vacío = descubrimiento automático activado (ver abajo).
# Si prefieres fijar tú mismo los pares, escribe algo como: BTC,ETH,SOL
TRADING_SYMBOLS=SOL,XRP,ADA,DOT,LTC,LINK,ATOM,BCH,ETH,DOGE,ALGO
RESTRICT_TO_MAJOR_SYMBOLS=false
MAJOR_SYMBOLS=SOL,XRP,ADA,DOT,LTC,LINK,ATOM,BCH,ETH
AUTO_DISCOVER_SYMBOLS=true
MAX_AUTO_SYMBOLS=15
TIMEFRAME=5m

# ─── Comisiones y rentabilidad neta ───────────────────────────────────────────
# Comisión taker de Kraken (orden de mercado), como fracción. 0.0026 = 0.26%.
# Ajusta si tu volumen de trading te da un tier de comisión mejor en Kraken.
KRAKEN_TAKER_FEE_PCT=0.0026
# Margen NETO mínimo (ya descontadas ambas comisiones, entrada+salida)
# exigido para cerrar una posición por toma de beneficio. El trailing stop
# de protección de capital SIEMPRE se ejecuta, ignore este umbral.
#
# CORREGIDO: estas 3 claves no estaban presentes en el .env, así que hasta
# ahora dependían en silencio del default de config.py — y ese default
# cambió varias veces durante el debugging. Se fijan aquí explícitamente
# con los valores ya validados para que no vuelvan a desincronizarse ni
# dependan de qué versión de config.py esté desplegada.
MIN_NET_PROFIT_PCT=0.006
# AJUSTADO: 0.0035 sobrecargaba el umbral de entrada (TP exigido ≈ 2.1%)
# rechazando edge estadístico legítimo. 0.002 sigue cubriendo el
# deslizamiento real de dos market orders en pares TARGET/BTC líquidos.
SLIPPAGE_BUFFER_PCT=0.002
MAX_POSITION_NOTIONAL_PCT=0.3
CATASTROPHIC_STOP_PCT=0.08
# ─── Detector de cambio de tendencia (popup del dashboard) ───────────────────
TREND_WATCH_EMA_FAST=9
TREND_WATCH_EMA_SLOW=26
TREND_WATCH_LOOKBACK_CANDLES=60
TREND_WATCH_MIN_SEPARATION_PCT=0.0015
TREND_WATCH_CONFIRM_CANDLES=3

CONFIDENCE_SIZE_MIN_MULT=0.5
CONFIDENCE_SIZE_MAX_MULT=1.5

# ─── Gestión de riesgo ───────────────────────────────────────────────────────
RISK_PER_TRADE=0.01
MAX_DAILY_DRAWDOWN=0.05
ATR_PERIOD=14
ATR_MULTIPLIER=3.0
MAX_OPEN_POSITIONS=14
MAX_POSITIONS_PER_STRATEGY=4
MAX_POSITION_HOLD_SECONDS=86400
MAX_HOLD_EXTENSION_MULT=1.5

# ─── Estrategia I — Dip Rebound (caída puntual en tendencia bajista) ─────────
DR_LOOKBACK=20
DR_DROP_PCT=0.015
DR_TARGET_NET_PCT=0.02
DR_EMA_FAST=9
DR_EMA_SLOW=21
DR_STOP_ATR_MULT=3.0

# ─── Estrategia J — Triangular Arb ───────────────────────────────────────────
TRI_LOOKBACK=48
TRI_MIN_ZSCORE=2.3
TRI_EXIT_ZSCORE=0.5

# ─── Estrategias (DELTA_NEUTRAL_ARB no aplica: no hay funding rate en spot) ──
ACTIVE_STRATEGIES=MEAN_REVERSION,CROSS_CURRENCY_ARB,TRIANGULAR_ARB
ENTRY_MODE=MOMENTUM
MR_VWAP_WINDOW=20
# CORREGIDO: 0.8 desviaciones estándar es un umbral muy laxo para mean
# reversion (entra con extensiones de precio pequeñas/poco significativas,
# más ruido que señal real). Subido a 1.5 para exigir una desviación más
# genuina antes de entrar — menos señales, pero de mayor calidad/win-rate.
MR_ZSCORE_THRESHOLD=1.5
MR_BB_PERIOD=20
MR_BB_STD=2.0
VB_VOLUME_THRESHOLD=0.08
VB_BREAKOUT_ATR_MULT=1.0
VB_ADX_THRESHOLD=20.0
VB_MIN_SQUEEZE_BARS=3
VB_EMA_PERIOD=50
VB_BB_PERIOD=20
SA_MIN_DEVIATION_PCT=0.01
VB_KC_ATR_MULT=1.5
CCA_MIN_EDGE_PCT=0.01

# ─── WebSocket / Reconexión ──────────────────────────────────────────────────
WS_RECONNECT_DELAY=5
WS_MAX_RECONNECTS=10
REST_TIMEOUT=10

# ─── Rate limiting (Kraken es más estricto que OKX) ──────────────────────────
RATE_LIMIT_ORDERS_PER_SECOND=1
RATE_LIMIT_WEIGHT_PER_MINUTE=60

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# ─── Dashboard web (UI gráfica) ───────────────────────────────────────────────
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8001
